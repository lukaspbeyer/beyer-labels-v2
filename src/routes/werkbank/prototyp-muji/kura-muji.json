{
	"typeface": { "font": "inter-tight", "weight": 400 },
	"sign": { "case": "upper", "trackingPercent": 8, "align": "center" },
	"text": { "case": "as-typed", "trackingPercent": 2, "align": "left" },
	"proportion": { "capHeightPerWidth": 0.075, "capHeightPerHeight": 0.25, "maxSignWidthRatio": 0.703125 },
	"subLine": { "capRatio": 0.55, "lineSpacing": 0.6 },
	"wood": {
		"grain": "horizontal",
		"process": "fill",
		"depth": "low",
		"burn": "medium",
		"fillColor": "black",
		"finish": "oiled",
		"shape": "rectangle",
		"cornerRadius": 0,
		"frame": false,
		"edge": "sanded"
	},
	"paper": { "ink": "#231f20", "textCapHeight": 3.1, "ruleWidth": 0.2 }
}
